NODE_ENV=development
TURSO_DATABASE_URL="libsql://your-db-url.turso.io" # or http://127.0.0.1:8080 for local
TURSO_AUTH_TOKEN="your_turso_auth_token"
BETTER_AUTH_SECRET="your_generated_secret_key"
BETTER_AUTH_URL=http://localhost:3000
AUTH_GITHUB_CLIENT_ID="your_github_client_id"
AUTH_GITHUB_CLIENT_SECRET="your_github_client_secret"
AUTH_GOOGLE_CLIENT_ID="your_google_client_id"
AUTH_GOOGLE_CLIENT_SECRET="your_google_client_secret"
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
S3_ACCESS_KEY="your_aws_access_key_id"
S3_ACCESS_SECRET="your_aws_secret_access_key"
S3_REGION="us-east-1"
S3_BUCKET="your_s3_bucket_name"
S3_BUCKET_URL="https://your-bucket-name.s3.us-east-1.amazonaws.com"
